<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/back_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:contentDescription="@string/lang_text_044"
                android:text="‹"
                android:textColor="@color/home_hero_start"
                android:textSize="36sp" />
            <TextView
                style="@style/HomeHeading"
                android:layout_marginStart="8dp"
                android:text="Tasbih"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">
        <TextView
            style="@style/HomeMuted"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/lang_text_039"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tasbih_count"
                style="@style/HomeText"
                android:minWidth="160dp"
                android:minHeight="144dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/home_hero_start"
                android:textSize="160sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold" />
            <TextView
                style="@style/HomeMuted"
                android:layout_marginTop="8dp"
                android:text="@string/lang_text_040"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            style="@style/HomeText"
            android:layout_width="match_parent"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="@string/lang_text_041"
            android:textSize="14sp" />
        <RadioGroup
            android:id="@+id/target_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/target_33"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:buttonTint="@color/home_purple"
                android:checked="true"
                android:text="33"  tools:textSize="14sp"/>
            <RadioButton
                android:id="@+id/target_99"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:buttonTint="@color/home_purple"
                android:text="99"  tools:textSize="14sp"/>
            <RadioButton
                android:id="@+id/target_free"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:buttonTint="@color/home_purple"
                android:text="@string/lang_text_042"  tools:textSize="14sp"/>
        </RadioGroup>

        <TextView
            android:id="@+id/reset_button"
            style="@style/HomeText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_tasbih_action"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/lang_text_043"
            android:textColor="@color/home_white"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
