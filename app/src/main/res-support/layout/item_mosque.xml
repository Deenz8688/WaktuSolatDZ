<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_home_prayer_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">
        <TextView
            android:id="@+id/name"
            style="@style/HomeText"
            android:duplicateParentState="true"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/home_prayer_text"
            android:textSize="14sp"
            tools:text="Masjid berdekatan" />
        <TextView
            android:id="@+id/distance"
            style="@style/HomeMuted"
            android:layout_marginTop="4dp"
            tools:text="Masjid · 1.2 km" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/navigate"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_tasbih_action"
        android:contentDescription="@string/lang_text_028"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="13dp"
        android:src="@drawable/ic_location"
        android:tint="@color/home_white" />
</LinearLayout>
