    <TextView style="@style/HomeMuted" android:layout_marginTop="5dp" tools:text="Masjid · 1.2 km" android:id="@+id/distance" />
    <Button android:id="@+id/navigate" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Buka peta" android:textAllCaps="false" android:textColor="@color/home_purple" />
</LinearLayout>