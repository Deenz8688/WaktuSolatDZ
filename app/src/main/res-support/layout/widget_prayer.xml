<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4x2: ringkasan waktu solat hari ini -->
<!-- Semua teks guna autoSizeTextType supaya saiz mengecil sendiri pada skrin/cell widget yang kecil -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Nama app di tengah -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Tarikh Hijri & Masihi -->
        <TextView
            android:id="@+id/widget_dates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_dates_sample"
            android:textColor="@color/widget_muted"
            android:textSize="8.5sp" />

        <!-- Solat seterusnya -->
        <TextView
            android:id="@+id/widget_next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:autoSizeMaxTextSize="9sp"
            android:autoSizeMinTextSize="6.5sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="@string/widget_next_label"
            android:textColor="@color/widget_muted"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_next_sample"
            android:textColor="@color/widget_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Jam semasa + cuaca & suhu kawasan -->
        <LinearLayout
            android:id="@+id/widget_now_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- TextClock: jam dikemas kini sendiri oleh sistem, tiada broadcast -->
            <TextClock
                android:id="@+id/widget_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="21sp"
                android:autoSizeMinTextSize="13sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/bg_widget_time_active"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="150dp"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textColor="@color/widget_highlight_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_weather_icon"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/cd_weather"
                android:src="@drawable/ic_weather_partly"
                android:tint="@color/widget_primary" />

            <TextView
                android:id="@+id/widget_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeMinTextSize="13sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="96dp"
                android:text="@string/widget_temp_sample"
                android:textColor="@color/widget_primary"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lapan waktu: imsak, fardu, syuruk & dhuha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_imsak_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/label_imsak"
                    android:textColor="@color/widget_muted"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/widget_imsak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_time_sample_fajr"
                    android:textColor="@color/widget_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_subuh_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/prayer_fajr"
                    android:textColor="@color/widget_muted"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/widget_subuh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_time_sample_fajr"
                    android:textColor="@color/widget_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_syuruk_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/label_syuruk"
                    android:textColor="@color/widget_muted"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/widget_syuruk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_time_sample_fajr"
                    android:textColor="@color/widget_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_dhuha_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/label_dhuha"
                    android:textColor="@color/widget_muted"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/widget_dhuha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_time_sample_fajr"
                    android:textColor="@color/widget_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_zohor_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/prayer_dhuhr"
                    android:textColor="@color/widget_muted"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/widget_zohor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_time_sample_dhuhr"
                    android:textColor="@color/widget_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_asar_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/prayer_asr"
                    android:textColor="@color/widget_muted"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/widget_asar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_time_sample_asr"
                    android:textColor="@color/widget_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_maghrib_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/prayer_maghrib"
                    android:textColor="@color/widget_muted"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/widget_maghrib"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_time_sample_maghrib"
                    android:textColor="@color/widget_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_isyak_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/prayer_isha"
                    android:textColor="@color/widget_muted"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/widget_isyak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_time_sample_isha"
                    android:textColor="@color/widget_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Zon kawasan -->
        <ImageView
            android:id="@+id/widget_location_icon"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:contentDescription="@string/cd_location"
            android:src="@drawable/ic_location"
            android:tint="@color/widget_primary" />

        <TextView
            android:id="@+id/widget_zone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_zone_sample"
            android:textColor="@color/widget_primary"
            android:textSize="8.5sp" />
    </LinearLayout>
</FrameLayout>
