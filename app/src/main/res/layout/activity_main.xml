<?xml version="1.0" encoding="utf-8"?>
<!--
    Draf layout skrin utama Waktu Solat DZ.
    Struktur: latar emas Islamik -> kad solat seterusnya -> jadual waktu -> quote.
    Semua saiz guna dp/sp; warna & teks diambil dari res/values.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gold_gradient">

    <!-- Motif geometri + siluet masjid -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/islamic_pattern" />

    <!-- Siluet masjid: duduk di atas menu bawah -->
    <ImageView
        android:id="@+id/ivMosqueSilhouette"
        android:layout_width="match_parent"
        android:layout_height="163dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="92dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/mosque_silhouette" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="32dp"
            android:paddingEnd="20dp"
            android:paddingBottom="112dp">

            <!-- ============ HEADER ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivCrescent"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/cd_crescent"
                    android:src="@drawable/ic_crescent_star" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.02"
                        android:text="@string/header_title"
                        android:textColor="@color/cream"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDateLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/header_subtitle"
                        android:textColor="@color/gold_100"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ KAD SOLAT SETERUSNYA ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card_cream"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="@string/label_next_prayer"
                    android:textColor="@color/gold_text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNextPrayerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/prayer_asr"
                            android:textColor="@color/gold_900"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/countdown_sample"
                            android:textColor="@color/gold_text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNextPrayerTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:05"
                        android:textColor="@color/gold_800"
                        android:textSize="36sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/gold_100" />

                <!-- Imsak / Syuruk / Dhuha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_imsak"
                            android:textColor="@color/gold_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvImsakTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="05:21"
                            android:textColor="@color/brown_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_syuruk"
                            android:textColor="@color/gold_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSyurukTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="06:48"
                            android:textColor="@color/brown_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_dhuha"
                            android:textColor="@color/gold_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvDhuhaTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="07:12"
                            android:textColor="@color/brown_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============ KAD JADUAL WAKTU SOLAT ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_cream"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/cd_mosque"
                        android:src="@drawable/ic_mosque"
                        android:tint="@color/gold_800" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/label_schedule"
                        android:textColor="@color/gold_900"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCityChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Algiers"
                        android:textColor="@color/gold_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Subuh -->
                <LinearLayout
                    android:id="@+id/rowFajr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_prayer_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/cd_mosque"
                        android:src="@drawable/ic_mosque"
                        android:tint="@color/gold_800" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/prayer_fajr"
                        android:textColor="@color/brown_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvFajrTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05:10"
                        android:textColor="@color/gold_900"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Zohor -->
                <LinearLayout
                    android:id="@+id/rowDhuhr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_prayer_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/cd_mosque"
                        android:src="@drawable/ic_mosque"
                        android:tint="@color/gold_800" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/prayer_dhuhr"
                        android:textColor="@color/brown_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvDhuhrTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:48"
                        android:textColor="@color/gold_900"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Asar (aktif) -->
                <LinearLayout
                    android:id="@+id/rowAsr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_prayer_row_active"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/cd_mosque"
                        android:src="@drawable/ic_mosque"
                        android:tint="@color/cream" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/prayer_asr"
                        android:textColor="@color/cream"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAsrTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:05"
                        android:textColor="@color/cream"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Maghrib -->
                <LinearLayout
                    android:id="@+id/rowMaghrib"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_prayer_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/cd_mosque"
                        android:src="@drawable/ic_mosque"
                        android:tint="@color/gold_800" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/prayer_maghrib"
                        android:textColor="@color/brown_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvMaghribTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="19:02"
                        android:textColor="@color/gold_900"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Isyak -->
                <LinearLayout
                    android:id="@+id/rowIsha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_prayer_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/cd_mosque"
                        android:src="@drawable/ic_mosque"
                        android:tint="@color/gold_800" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/prayer_isha"
                        android:textColor="@color/brown_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvIshaTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20:22"
                        android:textColor="@color/gold_900"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/footer_note"
                android:textColor="@color/gold_100"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Menu bawah -->
    <include
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</FrameLayout>
