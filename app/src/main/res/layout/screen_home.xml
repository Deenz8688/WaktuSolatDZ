<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:fillViewport="true"
    android:scrollbars="none"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="56dp"
    android:paddingBottom="24dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/status_card"
            style="@style/HomeCard"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp"
            tools:visibility="gone">
            <ProgressBar
                android:id="@+id/loading_progress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="@color/home_purple" />
            <TextView
                android:id="@+id/status_title"
                style="@style/HomeText"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Memuatkan waktu solat…" />
            <TextView
                android:id="@+id/error_message"
                style="@style/HomeMuted"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:visibility="gone"
                android:text="Tidak dapat memuatkan data." />
            <Button
                android:id="@+id/retry_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Cuba lagi"
                android:textAllCaps="false"
                android:textColor="@color/home_purple"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/home_content"
            android:visibility="gone"
            tools:visibility="visible">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_hero"
                android:clipToOutline="true"
                android:id="@+id/next_prayer">
                <!-- Weather artwork: edit position, size and colors here. -->
                <LinearLayout
                    android:id="@+id/weather_group"
                    android:layout_width="108dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:focusable="true"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <FrameLayout
                        android:layout_width="108dp"
                        android:layout_height="84dp">
                        <ImageView
                            android:id="@+id/weather_sun"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_gravity="top|end"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_weather_sun"
                            android:tint="#FFD476"
                            android:importantForAccessibility="no" />
                        <ImageView
                            android:id="@+id/weather_moon"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_gravity="top|end"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_crescent_star"
                            android:tint="#E5D9FF"
                            android:visibility="gone"
                            android:importantForAccessibility="no" />
                        <ImageView
                            android:id="@+id/weather_cloud"
                            android:layout_width="84dp"
                            android:layout_height="60dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginBottom="14dp"
                            android:src="@drawable/ic_weather_cloud"
                            android:tint="#F2EDFF"
                            android:importantForAccessibility="no" />
                        <ImageView
                            android:id="@+id/weather_rain"
                            android:layout_width="72dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_weather_drops"
                            android:visibility="gone"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        style="@style/HomeLabel"
                        android:text="SOLAT SETERUSNYA"
                        android:textColor="@color/home_hero_label"
                        android:textSize="10sp"
                        android:letterSpacing="0.20" />
                    <TextView
                        android:id="@+id/next_name"
                        style="@style/HomeText"
                        android:layout_marginTop="10dp"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/home_white"
                        android:text="Subuh"
                        tools:text="Subuh" />
                    <TextView
                        android:id="@+id/next_time"
                        style="@style/HomeText"
                        android:textSize="44sp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/home_white"
                        android:letterSpacing="-0.035"
                        android:text="05:50"
                        tools:text="05:50" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_home_timer"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_clock"
                            android:tint="@color/home_hero_label"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:id="@+id/countdown"
                            style="@style/HomeText"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/home_white"
                            android:fontFamily="sans-serif-medium"
                            android:text="7 jam 57 minit lagi"
                            tools:text="7 jam 57 minit lagi" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                style="@style/HomeCard"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_location"
                    android:tint="@color/home_purple"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/zone_district"
                        style="@style/HomeText"
                        android:fontFamily="sans-serif-medium"
                        android:text="Kuala Lumpur, Putrajaya"
                        tools:text="Kuala Lumpur, Putrajaya" />
                    <TextView
                        android:id="@+id/zone_state"
                        style="@style/HomeMuted"
                        android:layout_marginTop="3dp"
                        android:text="Wilayah Persekutuan"
                        tools:text="Wilayah Persekutuan" />
                </LinearLayout>
                <TextView
                    android:id="@+id/zone_code"
                    style="@style/HomeLabel"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_home_badge"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="WLY01"
                    tools:text="WLY01" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <LinearLayout
                    style="@style/HomeCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">
                    <TextView
                        style="@style/HomeLabel"
                        android:text="HARI INI" />
                    <TextView
                        android:id="@+id/gregorian_date"
                        style="@style/HomeText"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="5dp"
                        android:text="Jumaat, 6 November 2026"
                        tools:text="Jumaat, 6 November 2026" />
                </LinearLayout>
                <LinearLayout
                    style="@style/HomeCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">
                    <TextView
                        style="@style/HomeLabel"
                        android:text="TARIKH HIJRAH" />
                    <TextView
                        android:id="@+id/hijri_date"
                        style="@style/HomeText"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="5dp"
                        android:text="26 Jamadilawal 1448H"
                        tools:text="26 Jamadilawal 1448H" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/calendar_section"
                style="@style/HomeSection"
                android:background="@drawable/bg_home_card"
                android:padding="20dp">
                <TextView
                    style="@style/HomeHeading"
                    android:text="Tarikh Penting Islam" />
                <ScrollView
                    android:id="@+id/event_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_calendar_preview_height"
                    android:layout_marginTop="12dp"
                    android:fillViewport="false"
                    android:scrollbars="none"
                    android:overScrollMode="never">
                    <LinearLayout
                        android:id="@+id/event_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <!-- Editor-only row using the same XML as the live list. -->
                        <include
                            android:id="@+id/calendar_preview"
                            layout="@layout/item_home_islamic_event"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
            <TextView
                style="@style/HomeMuted"
                android:layout_width="match_parent"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:textSize="10sp"
                android:text="Waktu tempatan · Sumber e-Solat JAKIM" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
