<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true"
    android:scrollbars="none"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="56dp"
    android:paddingBottom="24dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/status_card"
            style="@style/HomeCard"
            android:elevation="4dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp"
            tools:visibility="gone">
            <ProgressBar
                android:id="@+id/loading_progress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="@color/home_purple" />
            <TextView
                android:id="@+id/status_title"
                style="@style/HomeText"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/lang_text_034" />
            <TextView
                android:id="@+id/error_message"
                style="@style/HomeMuted"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:visibility="gone"
                android:text="@string/lang_text_035" />
            <Button
                android:id="@+id/retry_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/lang_text_036"
                android:textAllCaps="false"
                android:textColor="@color/home_purple"
                android:visibility="gone"  tools:textSize="14sp" tools:gravity="center"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/home_content"
            android:clipChildren="false"
            android:visibility="gone"
            tools:visibility="visible">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_hero"
                android:elevation="4dp"
                android:clipToOutline="true"
                android:id="@+id/next_prayer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:padding="18dp"
                    android:paddingBottom="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.15"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/next_name"
                            style="@style/HomeText"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/home_white"
                            android:text="@string/lang_text_052"
                            tools:text="Subuh" />
                        <TextView
                            android:id="@+id/next_time"
                            style="@style/HomeText"
                            android:textSize="44sp"
                            android:fontFamily="sans-serif-light"
                            android:textColor="@color/home_white"
                            android:letterSpacing="-0.035"
                            android:text="05:50"
                            tools:text="05:50" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-4dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                style="@style/HomeLabel"
                                android:text="@string/lang_text_032"
                                android:textColor="@color/home_hero_label"
                                android:textSize="9sp"
                                android:letterSpacing="0.05" />
                            <TextView
                                android:id="@+id/countdown"
                                style="@style/HomeText"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/bg_home_timer"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textColor="@color/home_white"
                                android:textSize="9sp"
                                android:fontFamily="sans-serif-medium"
                                android:text="07:57:00"
                                tools:text="07:57:00" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="end">
                    <!-- Weather artwork: edit position, size and colors here. -->
                    <LinearLayout
                        android:id="@+id/weather_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:focusable="true"
                        android:visibility="invisible"
                        tools:visibility="visible">
                        <FrameLayout
                            android:layout_width="108dp"
                            android:layout_height="84dp"
                            android:layout_gravity="end">
                            <ImageView
                                android:id="@+id/weather_sun"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="top|end"
                                android:layout_marginEnd="5dp"
                                android:src="@drawable/ic_weather_sun"
                                android:tint="#FFD476"
                                android:importantForAccessibility="no" />
                            <ImageView
                                android:id="@+id/weather_moon"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="top|end"
                                android:layout_marginEnd="5dp"
                                android:src="@drawable/ic_crescent_star"
                                android:tint="#E5D9FF"
                                android:visibility="gone"
                                android:importantForAccessibility="no" />
                            <ImageView
                                android:id="@+id/weather_cloud"
                                android:layout_width="84dp"
                                android:layout_height="60dp"
                                android:layout_gravity="bottom|start"
                                android:layout_marginBottom="14dp"
                                android:src="@drawable/ic_weather_cloud"
                                android:tint="#F2EDFF"
                                android:importantForAccessibility="no" />
                            <ImageView
                                android:id="@+id/weather_rain"
                                android:layout_width="72dp"
                                android:layout_height="24dp"
                                android:layout_gravity="bottom|start"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_weather_drops"
                                android:visibility="gone"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                    </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:gravity="end">
                            <TextView
                                android:id="@+id/card_gregorian_date"
                                style="@style/HomeText"
                                android:layout_width="match_parent"
                                android:gravity="end"
                                android:textSize="9sp"
                                android:textColor="@color/home_white"
                                android:text="Jumaat, 6 November 2026"
                                tools:text="Jumaat, 6 November 2026" />
                            <TextView
                                android:id="@+id/card_hijri_date"
                                style="@style/HomeText"
                                android:layout_width="match_parent"
                                android:gravity="end"
                                android:layout_marginTop="2dp"
                                android:textSize="9sp"
                                android:textColor="@color/home_hero_label"
                                android:text="26 Jamadilawal 1448H"
                                tools:text="26 Jamadilawal 1448H" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:id="@+id/calendar_section"
                style="@style/HomeSection"
                android:background="@drawable/bg_home_card"
                android:elevation="4dp"
                android:padding="20dp">
                <TextView
                    style="@style/HomeHeading"
                    android:text="@string/lang_text_031" />
                <ScrollView
                    android:id="@+id/event_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_calendar_preview_height"
                    android:layout_marginTop="12dp"
                    android:fillViewport="false"
                    android:scrollbars="none"
                    android:overScrollMode="never">
                    <LinearLayout
                        android:id="@+id/event_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <!-- Editor-only row using the same XML as the live list. -->
                        <include
                            android:id="@+id/calendar_preview"
                            layout="@layout/item_home_islamic_event"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/shortcut_zikir"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_home_shortcut"
                        android:contentDescription="Zikir"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:padding="13dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_shortcut_zikir" />
                    <TextView
                        style="@style/HomeText"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Zikir"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/shortcut_tasbih"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_home_shortcut"
                        android:contentDescription="Tasbih"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:padding="13dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_shortcut_tasbih" />
                    <TextView
                        style="@style/HomeText"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Tasbih"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                style="@style/HomeMuted"
                android:layout_width="match_parent"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:textSize="10sp"
                android:text="@string/lang_text_033" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
