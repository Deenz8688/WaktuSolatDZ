<?xml version="1.0" encoding="utf-8"?>
<!--
    Menu bawah 3 item: Utama, Waktu Solat, Tetapan.
    Item aktif ditanda dengan pil emas muda di belakang ikon.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_nav"
    android:elevation="16dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <!-- Utama (aktif) -->
    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="6dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_nav_item_active">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_home"
                android:tint="@color/gold_800" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_home"
            android:textColor="@color/gold_800"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Waktu Solat -->
    <LinearLayout
        android:id="@+id/navPrayerTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="6dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="30dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/nav_prayer_time"
                android:src="@drawable/ic_clock"
                android:tint="@color/gold_text_muted" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_prayer_time"
            android:textColor="@color/gold_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Tetapan -->
    <LinearLayout
        android:id="@+id/navSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="6dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="30dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/nav_settings"
                android:src="@drawable/ic_settings"
                android:tint="@color/gold_text_muted" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_settings"
            android:textColor="@color/gold_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
