                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="0dp"
                    android:duplicateParentState="true"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/prayer_imsak_name"
                        style="@style/HomeText"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/schedule_prayer_text"
                        android:duplicateParentState="true"
                        android:text="Imsak"
                        tools:text="Imsak"
                        android:tag="prayer_name" />
                    <TextView
                        android:id="@+id/prayer_imsak_status"
                        style="@style/HomeMuted"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:text="@string/lang_text_037"
                        tools:text="Seterusnya"
                        android:tag="prayer_status"
                        android:visibility="gone"
                        tools:visibility="gone" />
                </LinearLayout>
                <TextView
                    android:id="@+id/prayer_imsak_time"
                    style="@style/HomeText"
                    android:layout_marginStart="8dp"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/schedule_prayer_text"
                    android:duplicateParentState="true"
                    android:text="05:40"
                    tools:text="05:40"
                    android:tag="prayer_time" />
            </LinearLayout>
            <LinearLayout
