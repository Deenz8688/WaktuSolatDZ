<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="0"
                android:startColor="@color/home_hero_start"
                android:centerColor="@color/home_hero_center"
                android:endColor="@color/home_hero_end" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/home_white" />
        </shape>
    </item>
</layer-list>
