<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <size android:width="42dp" android:height="24dp" />
            <solid android:color="#FFE5E1E8" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="42dp" android:height="24dp" />
            <gradient android:angle="0"
                android:startColor="@color/home_hero_start"
                android:centerColor="@color/home_hero_center"
                android:endColor="@color/home_hero_end" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="42dp" android:height="24dp" />
            <solid android:color="#FFD6CEDB" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
