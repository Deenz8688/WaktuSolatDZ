<?xml version="1.0" encoding="utf-8"?>
<!-- Ikon status bar notifikasi: ikut logo app (bulatan emas + bulan sabit + bintang).
     Ikon kecil notifikasi dilukis sebagai siluet (warna diabaikan), jadi logo
     dipermudah jadi bingkai bulatan + bulan sabit + bintang berwarna putih. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Bingkai bulatan logo -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,1.8 A10.2,10.2 0 1,0 12,22.2 A10.2,10.2 0 1,0 12,1.8 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5" />

    <!-- Bulan sabit & bintang di tengah (skala 0.75) -->
    <group
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:translateX="3"
        android:translateY="3">

        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M14.5,2.5 A9.5,9.5 0 1,0 14.5,21.5 A11,11 0 0,1 14.5,2.5 Z" />

        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M19.5,4 L20.25,5.95 L22.3,6.15 L20.75,7.5 L21.2,9.5 L19.5,8.4 L17.8,9.5 L18.25,7.5 L16.7,6.15 L18.75,5.95 Z" />
    </group>
</vector>
